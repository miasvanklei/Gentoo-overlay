OpenSSL 4.1 (openssl/openssl@b3003ff1ecac) changed
`d2i_OCSP_RESPONSE_bio` and `i2d_OCSP_RESPONSE_bio` to expand to
`ASN1_item_d2i_bio`/`ASN1_item_i2d_bio` with `OCSP_RESPONSE_it`, none of
which are in the shim, so `System.Security.Cryptography.Native.OpenSsl`
fails the `verify-so.sh` check against 4.1 headers:

```
Undefined symbol(s) found:
 ASN1_item_i2d_bio
 ASN1_item_d2i_bio
 OCSP_RESPONSE_it
```

This uses `ASN1_d2i_bio_of`/`ASN1_i2d_bio_of` directly, which is what
those macros expanded to before 4.1 and only needs functions already in
the shim. Adding the `ASN1_item_*` functions to the shim instead would
not work at runtime with OpenSSL 1.1.1, where `OCSP_RESPONSE_it` is a
data symbol rather than a function.
---
 .../libs/System.Security.Cryptography.Native/pal_x509.c     | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/src/native/libs/System.Security.Cryptography.Native/pal_x509.c b/src/native/libs/System.Security.Cryptography.Native/pal_x509.c
index 815c0354608ce5..cd99c3e51a7735 100644
--- a/src/native/libs/System.Security.Cryptography.Native/pal_x509.c
+++ b/src/native/libs/System.Security.Cryptography.Native/pal_x509.c
@@ -1136,7 +1136,9 @@ int32_t CryptoNative_X509ChainGetCachedOcspStatus(X509_STORE_CTX* storeCtx, char
 
     if (bio != NULL)
     {
-        resp = d2i_OCSP_RESPONSE_bio(bio, NULL);
+        // OpenSSL 4.1 defines d2i_OCSP_RESPONSE_bio and i2d_OCSP_RESPONSE_bio in terms of
+        // ASN1_item_d2i_bio, ASN1_item_i2d_bio and OCSP_RESPONSE_it, which are not in the shim.
+        resp = ASN1_d2i_bio_of(OCSP_RESPONSE, OCSP_RESPONSE_new, d2i_OCSP_RESPONSE, bio, NULL);
         BIO_free(bio);
     }
 
@@ -1261,7 +1263,7 @@ static int32_t X509ChainVerifyOcsp(X509_STORE_CTX* storeCtx, X509* subject, X509
            {
 #pragma clang diagnostic push
 #pragma clang diagnostic ignored "-Wcast-qual"
-                if (i2d_OCSP_RESPONSE_bio(bio, resp))
+                if (ASN1_i2d_bio_of(OCSP_RESPONSE, i2d_OCSP_RESPONSE, bio, resp))
 #pragma clang diagnostic pop
                 {
                     clearErr = 0;
