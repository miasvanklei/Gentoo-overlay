+static NM80211ApSecurityFlags
+ap_security_flags_from_network(NMDeviceIwd *self, GDBusProxy *network, const char *type)
+{
+    NMDeviceIwdPrivate        *priv  = NM_DEVICE_IWD_GET_PRIVATE(self);
+    NM80211ApSecurityFlags     flags = NM_802_11_AP_SEC_NONE;
+    gs_unref_variant GVariant *ess   = NULL;
+    GVariantIter               iter;
+    const char                *bss_path;
+
+    ess = g_dbus_proxy_get_cached_property(network, "ExtendedServiceSet");
+    if (!nm_g_variant_is_of_type(ess, G_VARIANT_TYPE("ao")))
+        return ap_security_flags_from_network_type(type);
+
+    g_variant_iter_init(&iter, ess);
+    while (g_variant_iter_next(&iter, "&o", &bss_path)) {
+        gs_unref_object GDBusProxy *bss = NULL;
+        gs_unref_variant GVariant  *rsn = NULL;
+
+        bss = nm_iwd_manager_get_dbus_interface(priv->manager, bss_path, NM_IWD_BSS_INTERFACE);
+        if (!bss)
+            continue;
+
+        rsn = g_dbus_proxy_get_cached_property(bss, "RSN");
+        if (!nm_g_variant_is_of_type(rsn, G_VARIANT_TYPE_VARDICT))
+            continue;
+
+        flags |= nm_supplicant_bss_security_from_variant(rsn);
+    }
+
+    return flags != NM_802_11_AP_SEC_NONE ? flags : ap_security_flags_from_network_type(type);
+}
